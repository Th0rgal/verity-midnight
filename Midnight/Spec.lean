import Midnight.Import

/-!
# The Certora rule `updatePositionViewProperties`

[certora/specs/UpdatePositionView.spec#L127-L150](https://github.com/morpho-org/midnight/blob/96d31343e993329e7a593dde46516a2c0cbcd142/certora/specs/UpdatePositionView.spec#L127C2-L150C4),
stated on the model imported from Midnight's Solidity.

## Claim

For any Midnight storage, `obligation`, `id` and `user` with
`lastLossFactor(id, user) <= marketState[id].lossFactor`, if
`updatePositionView(obligation, id, user)` returns `newCredit, newPendingFee, fee`:
1. `fee <= oldPendingFee`: "Cannot take more fee than pending";
2. `(newCredit + fee) * mapFactor(lastLossFactor) <= oldCredit * mapFactor(lossFactor)`:
   "newCredit (with fees) is at most precise credit after slashing";
3. `newCredit <= oldCredit`: "slashing and fee accrual only decrease credit";
4. `newPendingFee <= oldPendingFee`: "fee deduction only decreases pending";
5. `mapFactor(lossFactor) == 0 => newCredit == 0 && fee == 0`:
   "no credit/fee on total loss factor".

`updatePositionViewProperties` below states this; `Proof.lean` proves it.

## Differences with the CVL rule

- **No ghosts.** The CVL writes assertion 2 with the ghosts `PRECISION` and
  `preciseCreditDivFactor`, where the invariant `preciseCreditCorrect` gives
  `preciseCreditDivFactor * mapFactor(lastLossFactor) == PRECISION * credit`.
  Substituting it yields assertion 2 above. The ghosts, `axiom PRECISION > 0`
  and `requireInvariant` are only needed across transactions, not for one call.
- **No timestamp `require`**: `e.block.timestamp >= oldLastAccrual` is not needed.
- **`obligation`, `id` and `user` are ABI calldata.** The importer decodes the
  whole `Market` struct (including its dynamic `collateralParams` array) from
  `world.calldata`, the ABI words after the selector, and generates no typed call
  for a struct signature. `updatePositionView` below runs the imported model on
  `world`'s calldata, and the rule quantifies over every calldata whose head
  words 1 and 2 are `id` and `user`. Every ABI encoding of an `obligation` is
  covered; calldata that is not a valid encoding reverts in the model.
- **Any mapping-slot `oracle`**, so the claim holds for Keccak slots in particular.

The storage readers (`midnight.position.credit`, ...) are generated by the
import, with Solidity types.
-/

open Compiler.CompilationModel.Denote
open Verity.Core
namespace Midnight.Spec

/-- The pre-state storage the rule reads. -/
structure Old where
  /-- `oldCredit = cvlCredit(id, user)`, i.e. `position[id][user].credit` -/
  credit : UIntN 128
  /-- `oldPendingFee = pendingFeeMirror[id][user]`, i.e. `position[id][user].pendingFee` -/
  pendingFee : UIntN 128
  /-- `lastLossFactor(id, user)`, i.e. `position[id][user].lastLossFactor` -/
  lastLossFactor : UIntN 128
  /-- `lossFactor(id)`, i.e. `currentContract.marketState[id].lossFactor` -/
  lossFactor : UIntN 128

/-- Read `Old` from the storage `world`. -/
def old (oracle : DenoteOracle) (world : Verity.ContractState) (id : BytesN 32)
    (user : Address) : Old where
  credit := midnight.position.credit oracle world id user
  pendingFee := midnight.position.pendingFee oracle world id user
  lastLossFactor := midnight.position.lastLossFactor oracle world id user
  lossFactor := midnight.marketState.lossFactor oracle world id

/-- `updatePositionView(obligation, id, user)` on the imported model, with the
arguments ABI-encoded in `world.calldata`; `none` means it reverts. -/
def updatePositionView (oracle : DenoteOracle) (world : Verity.ContractState) :
    Option (UIntN 128 × UIntN 128 × UIntN 128) :=
  match Compiler.CompilationModel.SolidityImport.runFunction oracle midnight.model
      "updatePositionView" world [] with
  | some [r0, r1, r2] =>
      some (Compiler.CompilationModel.SolidityImport.Word.ofWord r0,
        Compiler.CompilationModel.SolidityImport.Word.ofWord r1,
        Compiler.CompilationModel.SolidityImport.Word.ofWord r2)
  | _ => none

/-- `definition mapFactor(mathint factor) returns mathint = 2 ^ 128 - 1 - factor;` -/
def mapFactor (factor : UIntN 128) : Int := 2 ^ 128 - 1 - factor.val

/-- The `require` of the rule. -/
structure Requires (old : Old) : Prop where
  /-- `require lastLossFactor(id, user) <= currentContract.marketState[id].lossFactor,
  "lastLossFactorLeqMarketLossFactor in Midnight";` -/
  lastLossFactorLeqMarketLossFactor : old.lastLossFactor ≤ old.lossFactor

/-- The five `assert`s of the rule, in order. -/
structure Asserts (old : Old) (newCredit newPendingFee fee : UIntN 128) : Prop where
  /-- `assert fee <= oldPendingFee, "Cannot take more fee than pending";` -/
  feeLeOldPendingFee : fee ≤ old.pendingFee
  /-- "newCredit (with fees) is at most precise credit after slashing": the credit
  rescaled from the position's loss factor to the market's bounds `newCredit + fee`.
  The CVL states it with ghosts; see "No ghosts" above. -/
  creditWithFeeLeCreditAfterSlashing :
    ((newCredit.val : Int) + fee.val) * mapFactor old.lastLossFactor ≤
      old.credit.val * mapFactor old.lossFactor
  /-- `assert newCredit <= oldCredit, "slashing and fee accrual only decrease credit";` -/
  newCreditLeOldCredit : newCredit ≤ old.credit
  /-- `assert newPendingFee <= oldPendingFee, "fee deduction only decreases pending";` -/
  newPendingFeeLeOldPendingFee : newPendingFee ≤ old.pendingFee
  /-- `assert mapFactor(currentContract.marketState[id].lossFactor) == 0 =>
  newCredit == 0 && fee == 0, "no credit/fee on total loss factor";` -/
  noCreditFeeOnTotalLossFactor : mapFactor old.lossFactor = 0 → newCredit = 0 ∧ fee = 0

/-- `rule updatePositionViewProperties(env e, Midnight.Market obligation, bytes32 id, address user)`:
for every storage `world`, if the `Requires` hold and
`newCredit, newPendingFee, fee = updatePositionView(e, obligation, id, user)` succeeds,
the `Asserts` hold. -/
def updatePositionViewProperties : Prop :=
  ∀ (oracle : DenoteOracle) (world : Verity.ContractState)
    (id : BytesN 32) (user : Address)
    (newCredit newPendingFee fee : UIntN 128),
    let old := Spec.old oracle world id user
    world.calldata.getD 1 0 = id.val →
    world.calldata.getD 2 0 = user.val →
    Requires old →
    updatePositionView oracle world =
      some (newCredit, newPendingFee, fee) →
    Asserts old newCredit newPendingFee fee

end Midnight.Spec
